# ================================================================================
# MANILA AUTO PROS - ENVIRONMENT CONFIGURATION PLACEHOLDERS
# Copy this file to `.env.local` and supply your real project credentials.
# Never commit `.env.local` or expose server secrets to browser code.
# ================================================================================

# Canonical site origin
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: set to "true" on preview deployments to show development notices
NEXT_PUBLIC_SHOW_DEV_NOTICES=false
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_placeholder
SUPABASE_SERVICE_ROLE_KEY=sb_secret_placeholder

# Private preview only. PUBLIC_BOOKING_ENABLED is rejected unless demo mode is
# active, the URL matches the project marker, email is disabled, and at least
# one explicitly reviewed demo service slug is allowed.
STAGING_DEMO_MODE=false
PUBLIC_BOOKING_ENABLED=false
STAGING_SUPABASE_PROJECT_REF=
STAGING_DEMO_SERVICE_SLUGS=

# Server-only bearer secret for trusted manual expiration-job requests.
# Generate at least 32 random characters and store it only in the hosting
# provider's encrypted environment settings. Supabase Cron does not need it
# because the recommended schedule invokes the database function directly.
ADMIN_CRON_SECRET=replace-with-at-least-32-random-characters

# ================================================================================
# PHASE 5 TRANSACTIONAL EMAIL (delivery remains off unless explicitly enabled)
# ================================================================================
EMAIL_DELIVERY_MODE=disabled

# Server-only Resend settings. Do not use NEXT_PUBLIC_ prefixes.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_ADMIN_NOTIFICATION_EMAILS=
RESEND_WEBHOOK_SECRET=

# Required only when EMAIL_DELIVERY_MODE=development. Every recipient is replaced
# with this controlled mailbox so development cannot email a customer by mistake.
EMAIL_TEST_RECIPIENT=

# Server-only authorization for the dormant email-dispatch job endpoint.
# Database delivery must also be separately activated with an owner-approved
# cutoff before this endpoint can claim any events.
EMAIL_DISPATCH_SECRET=

# Base64 encoding of exactly 32 random bytes for domain-separated AES-256-GCM
# management-link and frozen email-payload envelopes.
# Increment the version when rotating. Keep still-needed old keys as a JSON object,
# for example {"2026-q4":"<old-base64-key>"}. Never commit real values.
EMAIL_TOKEN_ENCRYPTION_KEY=
EMAIL_TOKEN_ENCRYPTION_KEY_VERSION=
EMAIL_TOKEN_ENCRYPTION_PREVIOUS_KEYS=
