# ==============================================================================
# MANILA AUTO PROS — ENVIRONMENT CONFIGURATION PLACEHOLDERS
# Copy this file to `.env.local` and supply your real project credentials.
# NEVER commit `.env.local` or expose `SUPABASE_SERVICE_ROLE_KEY` to the client.
# ==============================================================================

# Canonical site origin
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: set to "true" on preview deployments to show development notices
NEXT_PUBLIC_SHOW_DEV_NOTICES=false

# Supabase Public Configuration (Browser & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key-placeholder

# Supabase Privileged Server-Only Key (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-placeholder
